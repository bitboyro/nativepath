# The versions the benchmark image, CI and the setup scripts agree on. Change them here.
# The code itself needs JDK 22 or newer (the Foreign Function & Memory API); this is what is tested.
JDK_MAJOR=23
RUST_VERSION=1.99.1
MAVEN_VERSION=3.9.13
# The base image the bundle is built and run in. Its glibc (2.28 for Rocky Linux 8) is the oldest a
# machine can have and still load libnativepath.so: Rocky/Alma/RHEL 8, 9 and 10, Ubuntu 20.04 and later.
BASE_IMAGE=rockylinux:8
